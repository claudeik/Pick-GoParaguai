# Build do app do turista (npm run build:turista). O app instalado não tem o proxy do Vite:
# aponte para o endereço público da API, com HTTPS. Vazio = mesmo endereço (só para testar no navegador).
VITE_API_URL=
# true depois de colocar o google-services.json do Firebase em android/app/ (push no Android).
VITE_PUSH_ANDROID=false
